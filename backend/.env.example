# Copy to .env for local development. Never commit .env.
ORS_API_KEY=your_openrouteservice_key_here
DJANGO_SECRET_KEY=generate_a_new_random_secret_key
# Keep False in production; set True only for local development.
DJANGO_DEBUG=False
# Production: set to the actual deployed domain(s), comma-separated.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Production: set to the deployed frontend origin(s), comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Per-IP limit on POST /api/plan/ and how many reverse proxies sit in front of the app (see settings.py).
PLAN_THROTTLE_RATE=15/hour
THROTTLE_NUM_PROXIES=1
